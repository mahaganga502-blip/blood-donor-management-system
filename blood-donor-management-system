# Blood Donor Management System
donors = []
while True:
    print("\n===== BLOOD DONOR MANAGEMENT SYSTEM =====")
    print("1. Add Donor")
    print("2. View Donors")
    print("3. Search Donor by Blood Group")
    print("4. Exit")
    choice = input("Enter your choice: ")
    if choice == "1":
        name = input("Enter donor name: ")
        age = input("Enter donor age: ")
        blood_group = input("Enter blood group: ")
        phone = input("Enter phone number: ")
        donors.append([name, age, blood_group, phone])
        print("Donor added successfully!")
    elif choice == "2":
        print("\n--- DONOR LIST ---")
        if len(donors) == 0:
            print("No donors available.")
        else:
            for i, donor in enumerate(donors, 1):
                print("\nDonor", i)
                print("Name:", donor[0])
                print("Age:", donor[1])
                print("Blood Group:", donor[2])
                print("Phone:", donor[3])
    elif choice == "3":
        group = input("Enter blood group to search: ")
        found = False
        print("\n--- SEARCH RESULTS ---")
        for donor in donors:
            if donor[2].lower() == group.lower():
                print("Name:", donor[0])
                print("Age:", donor[1])
                print("Blood Group:", donor[2])
                print("Phone:", donor[3])
                print()
                found = True
        if not found:
            print("No donor found for this blood group.")
    elif choice == "4":
        print("Thank you for using Blood Donor Management System!")
        break
    else:
        print("Invalid choice. Please try again.")

